{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cloudquery/cloudquery/cli/v6/internal/specs/v0/spec",
  "$ref": "#/$defs/Spec",
  "$defs": {
    "BackendOptions": {
      "properties": {
        "table_name": {
          "type": "string",
          "minLength": 1,
          "description": "The name of the table to store the key-value pairs for incremental progress."
        },
        "connection": {
          "type": "string",
          "minLength": 1,
          "description": "Connection string for the destination plugin.\nCan be either `@@plugin.name.connection` or a fully-qualified gRPC connection string."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "table_name",
        "connection"
      ],
      "description": "Backend options to be used in conjunction with incremental tables (stores the incremental progres)"
    },
    "Destination": {
      "if": {
        "properties": {
          "registry": {
            "enum": [
              "",
              "github",
              "cloudquery"
            ]
          }
        },
        "title": "if registry is unset or is either `github` or `cloudquery`"
      },
      "then": {
        "properties": {
          "version": {
            "type": "string",
            "pattern": "^v.*$"
          }
        },
        "required": [
          "version"
        ],
        "title": "require version to be present"
      },
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Name of the plugin to use"
        },
        "version": {
          "type": "string",
          "description": "Version of the plugin to be used"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Path is the canonical path to the plugin in a given registry\nFor example:\n* for `registry: github` the `path` will be: `org/repo`\n* for `registry: local` the `path` will be the path to the binary: `./path/to/binary`\n* for `registry: grpc` the `path` will be the address of the gRPC server: `host:port`\n* for `registry: cloudquery` the `path` will be: `team/name`"
        },
        "registry": {
          "type": "string",
          "enum": [
            "",
            "github",
            "local",
            "grpc",
            "docker",
            "cloudquery"
          ],
          "description": "Registry can be \"\", \"github\", \"local\", \"grpc\", \"docker\", \"cloudquery\"",
          "default": "cloudquery"
        },
        "docker_registry_auth_token": {
          "type": "string",
          "description": "DockerRegistryAuthToken is the token to use to authenticate with the docker registry"
        },
        "write_mode": {
          "type": "string",
          "enum": [
            "overwrite-delete-stale",
            "overwrite",
            "append"
          ],
          "description": "Destination plugin write mode",
          "default": "overwrite-delete-stale"
        },
        "migrate_mode": {
          "type": "string",
          "enum": [
            "safe",
            "forced"
          ],
          "description": "Destination plugin migrate mode",
          "default": "safe"
        },
        "pk_mode": {
          "type": "string",
          "enum": [
            "default",
            "cq-id-only"
          ],
          "description": "Destination plugin PK mode",
          "default": "default"
        },
        "sync_group_id": {
          "type": "string"
        },
        "send_sync_summary": {
          "type": "boolean"
        },
        "transformers": {
          "oneOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array",
              "description": "Transformers are the names of transformer plugins to send sync data through"
            },
            {
              "type": "null"
            }
          ]
        },
        "spec": {
          "oneOf": [
            {
              "type": "object",
              "description": "Destination plugin own (nested) spec"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name",
        "path"
      ],
      "description": "Destination plugin spec"
    },
    "Duration": {
      "type": "string",
      "pattern": "^[-+]?([0-9]*(\\.[0-9]*)?[a-z]+)+$",
      "title": "CloudQuery configtype.Duration"
    },
    "EventsOptions": {
      "properties": {
        "follow": {
          "type": "boolean",
          "description": "Follow keeps the sync running and streaming changes until it is stopped. When `false` the sync exits once the source is caught up.",
          "default": false
        },
        "full_sync": {
          "type": "string",
          "enum": [
            "always",
            "on_first_run",
            "never"
          ],
          "description": "FullSync decides when a full sync runs before the CLI starts following the change stream.",
          "default": "on_first_run"
        },
        "max_checkpoint_age": {
          "oneOf": [
            {
              "$ref": "#/$defs/Duration",
              "description": "MaxCheckpointAge forces a full sync when the source's checkpoint is older than this duration. Unset means the checkpoint never expires."
            },
            {
              "type": "null"
            }
          ]
        },
        "batch_max_changes": {
          "type": "integer",
          "minimum": 1,
          "description": "BatchMaxChanges is the number of changes that closes a refresh batch.",
          "default": 500
        },
        "batch_max_wait": {
          "oneOf": [
            {
              "$ref": "#/$defs/Duration",
              "description": "BatchMaxWait is how long a refresh batch waits for more changes after the first change of the batch arrived."
            },
            {
              "type": "null"
            }
          ]
        },
        "summary_interval": {
          "oneOf": [
            {
              "$ref": "#/$defs/Duration",
              "description": "SummaryInterval is how often a sync summary is written while following the change stream."
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "type": "object",
      "description": "EventsOptions tunes `sync_mode: events`."
    },
    "Source": {
      "if": {
        "properties": {
          "registry": {
            "enum": [
              "",
              "github",
              "cloudquery"
            ]
          }
        },
        "title": "if registry is unset or is either `github` or `cloudquery`"
      },
      "then": {
        "properties": {
          "version": {
            "type": "string",
            "pattern": "^v.*$"
          }
        },
        "required": [
          "version"
        ],
        "title": "require version to be present"
      },
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Name of the plugin to use"
        },
        "version": {
          "type": "string",
          "description": "Version of the plugin to be used"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Path is the canonical path to the plugin in a given registry\nFor example:\n* for `registry: github` the `path` will be: `org/repo`\n* for `registry: local` the `path` will be the path to the binary: `./path/to/binary`\n* for `registry: grpc` the `path` will be the address of the gRPC server: `host:port`\n* for `registry: cloudquery` the `path` will be: `team/name`"
        },
        "registry": {
          "type": "string",
          "enum": [
            "",
            "github",
            "local",
            "grpc",
            "docker",
            "cloudquery"
          ],
          "description": "Registry can be \"\", \"github\", \"local\", \"grpc\", \"docker\", \"cloudquery\"",
          "default": "cloudquery"
        },
        "docker_registry_auth_token": {
          "type": "string",
          "description": "DockerRegistryAuthToken is the token to use to authenticate with the docker registry"
        },
        "tables": {
          "items": {
            "type": "string",
            "minLength": 1
          },
          "type": "array",
          "minItems": 1,
          "description": "Tables to sync from the source plugin"
        },
        "skip_tables": {
          "oneOf": [
            {
              "items": {
                "type": "string",
                "minLength": 1
              },
              "type": "array",
              "description": "SkipTables defines tables to skip when syncing data. Useful if a glob pattern is used in Tables"
            },
            {
              "type": "null"
            }
          ]
        },
        "skip_dependent_tables": {
          "oneOf": [
            {
              "type": "boolean",
              "description": "SkipDependentTables changes the matching behavior with regard to dependent tables. If set to `false`, dependent tables will be included in the sync when their parents are matched, even if not explicitly included by the `tables` configuration.",
              "default": true
            },
            {
              "type": "null"
            }
          ]
        },
        "destinations": {
          "items": {
            "type": "string",
            "minLength": 1
          },
          "type": "array",
          "minItems": 1,
          "description": "Destinations are the names of destination plugins to send sync data to"
        },
        "backend_options": {
          "oneOf": [
            {
              "$ref": "#/$defs/BackendOptions",
              "description": "Optional Backend options for sync operation"
            },
            {
              "type": "null"
            }
          ]
        },
        "sync_mode": {
          "type": "string",
          "enum": [
            "full",
            "events"
          ],
          "description": "SyncMode selects how the source is synced: `full` syncs every selected table, `events` follows the source's change events and refreshes only the resources that changed.",
          "default": "full"
        },
        "events": {
          "oneOf": [
            {
              "$ref": "#/$defs/EventsOptions",
              "description": "Events tunes `sync_mode: events`. It is only valid with that sync mode."
            },
            {
              "type": "null"
            }
          ]
        },
        "spec": {
          "oneOf": [
            {
              "type": "object",
              "description": "Source plugin own (nested) spec"
            },
            {
              "type": "null"
            }
          ]
        },
        "deterministic_cq_id": {
          "type": "boolean",
          "description": "DeterministicCQID is a flag that indicates whether the source plugin should generate a random UUID as the value of `_cq_id`\nor whether it should calculate a UUID that is a hash of the primary keys (if they exist) or the entire resource.",
          "default": false
        },
        "otel_endpoint": {
          "type": "string",
          "description": "If specified this will spawn the plugin with `--otel-endpoint`",
          "default": ""
        },
        "otel_endpoint_insecure": {
          "type": "boolean",
          "description": "If specified this will spawn the plugin with `--otel-endpoint-insecure`",
          "default": false
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name",
        "path",
        "tables",
        "destinations"
      ],
      "description": "Source plugin spec"
    },
    "Spec": {
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "type": "string",
                "const": "source",
                "description": "CloudQuery plugin kind"
              }
            }
          },
          "then": {
            "properties": {
              "spec": {
                "$ref": "#/$defs/Source"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "type": "string",
                "const": "destination",
                "description": "CloudQuery plugin kind"
              }
            }
          },
          "then": {
            "properties": {
              "spec": {
                "$ref": "#/$defs/Destination"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "type": "string",
                "const": "transformer",
                "description": "CloudQuery plugin kind"
              }
            }
          },
          "then": {
            "properties": {
              "spec": {
                "$ref": "#/$defs/Transformer"
              }
            }
          }
        }
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "source",
            "destination",
            "transformer"
          ],
          "description": "CloudQuery plugin kind"
        },
        "spec": {
          "oneOf": [
            {
              "description": "CloudQuery plugin (top-level) spec"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "kind",
        "spec"
      ]
    },
    "Transformer": {
      "if": {
        "properties": {
          "registry": {
            "enum": [
              "",
              "github",
              "cloudquery"
            ]
          }
        },
        "title": "if registry is unset or is either `github` or `cloudquery`"
      },
      "then": {
        "properties": {
          "version": {
            "type": "string",
            "pattern": "^v.*$"
          }
        },
        "required": [
          "version"
        ],
        "title": "require version to be present"
      },
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Name of the plugin to use"
        },
        "version": {
          "type": "string",
          "description": "Version of the plugin to be used"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Path is the canonical path to the plugin in a given registry\nFor example:\n* for `registry: github` the `path` will be: `org/repo`\n* for `registry: local` the `path` will be the path to the binary: `./path/to/binary`\n* for `registry: grpc` the `path` will be the address of the gRPC server: `host:port`\n* for `registry: cloudquery` the `path` will be: `team/name`"
        },
        "registry": {
          "type": "string",
          "enum": [
            "",
            "github",
            "local",
            "grpc",
            "docker",
            "cloudquery"
          ],
          "description": "Registry can be \"\", \"github\", \"local\", \"grpc\", \"docker\", \"cloudquery\"",
          "default": "cloudquery"
        },
        "docker_registry_auth_token": {
          "type": "string",
          "description": "DockerRegistryAuthToken is the token to use to authenticate with the docker registry"
        },
        "spec": {
          "oneOf": [
            {
              "type": "object",
              "description": "Transformer plugin own (nested) spec"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name",
        "path"
      ],
      "description": "Transformer plugin spec"
    }
  }
}
